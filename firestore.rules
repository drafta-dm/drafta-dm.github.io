rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // L'host ha permessi di scrittura completi
        resource.data.hostId == request.auth.uid || 
        // I partecipanti possono solo aggiornare lo stato senza modificare i metadati critici della stanza
        (
          request.resource.data.get('hostId', null) == resource.data.get('hostId', null) &&
          request.resource.data.get('password', null) == resource.data.get('password', null) &&
          request.resource.data.get('settings', null) == resource.data.get('settings', null) &&
          (
            // Se sono già partecipanti
            request.auth.uid in resource.data.participantIds ||
            // Oppure si stanno unendo alla stanza aggiungendo unicamente il proprio UID
            (
              request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
              request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1 &&
              request.auth.uid in request.resource.data.participantIds
            )
          )
        )
      );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
  }
}
